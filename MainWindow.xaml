<Window x:Class="ChatRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ChatRoom.Models"
        xmlns:vm="clr-namespace:ChatRoom.ViewModels"
        mc:Ignorable="d"
        Title="ChatRoom 聊天室" Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:BoolToHorizontalAlignmentConverter x:Key="BoolToAlign"/>

        <!-- 系统消息 -->
        <DataTemplate DataType="{x:Type vm:SystemMessageItem}">
            <TextBlock Text="{Binding Text}" Foreground="#7F8C8D" FontStyle="Italic"
                       TextWrapping="Wrap" Margin="2,2"/>
        </DataTemplate>

        <!-- 文本消息：本人右对齐蓝色气泡，他人左对齐灰色气泡 -->
        <DataTemplate DataType="{x:Type vm:ChatMessageItem}">
            <StackPanel Margin="2,6" HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                <StackPanel Orientation="Horizontal" Margin="2,0,2,2"
                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                    <TextBlock Text="{Binding SenderDisplay}" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding Data.SentTime, StringFormat='  {0:HH:mm:ss}'}" Foreground="#95A5A6" FontSize="10" Margin="6,1,0,0"/>
                </StackPanel>
                <Border MaxWidth="480" Padding="10,7" CornerRadius="6"
                        HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#ECF0F1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter Property="Background" Value="#3498DB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Data.Content}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#303030"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 文件消息：本人右对齐 -->
        <DataTemplate DataType="{x:Type vm:FileMessageItem}">
            <StackPanel Margin="2,6" HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                <StackPanel Orientation="Horizontal" Margin="2,0,2,2"
                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                    <TextBlock Text="{Binding SenderDisplay}" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding Data.SentTime, StringFormat='  {0:HH:mm:ss}'}" Foreground="#95A5A6" FontSize="10" Margin="6,1,0,0"/>
                </StackPanel>
                <Border MaxWidth="520" Padding="8,5" CornerRadius="6"
                        HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0F2F5"/>
                            <Setter Property="BorderBrush" Value="#D5DBDB"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter Property="Background" Value="#D6EAF8"/>
                                    <Setter Property="BorderBrush" Value="#A9CCE3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Data.FileName}" Foreground="#2C3E50" Margin="6,0,6,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SizeText}" Foreground="#7F8C8D" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" Foreground="#F39C12" VerticalAlignment="Center"/>
                        <Button Content="下载" Click="BtnDownload_Click" Tag="{Binding}"
                                Background="#3498DB" Foreground="White" BorderThickness="0" Padding="10,2"
                                Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 图片消息：本人右对齐 -->
        <DataTemplate DataType="{x:Type vm:ImageMessageItem}">
            <StackPanel Margin="2,6" HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                <StackPanel Orientation="Horizontal" Margin="2,0,2,2"
                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                    <TextBlock Text="{Binding SenderDisplay}" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding Data.SentTime, StringFormat='  {0:HH:mm:ss}'}" Foreground="#95A5A6" FontSize="10" Margin="6,1,0,0"/>
                </StackPanel>
                <Border BorderBrush="#D5DBDB" BorderThickness="1" Padding="3" CornerRadius="6"
                        HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            Click="ImgView_Click" Tag="{Binding}"
                            ToolTip="点击查看原图（需认证）">
                        <Image Source="{Binding ImageSource}" MaxWidth="200" MaxHeight="150" Stretch="Uniform"/>
                    </Button>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 已加入房间列表项 -->
        <DataTemplate DataType="{x:Type vm:JoinedRoomItem}">
            <Grid Margin="2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#E74C3C" VerticalAlignment="Center"
                             Visibility="{Binding HasNewMessage, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding RoomId}" FontWeight="Bold" Foreground="#2C3E50" Margin="5,0,4,0"/>
                    <TextBlock Text="{Binding Name}" Foreground="#34495E" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="13,1,0,0">
                    <TextBlock Text="{Binding OnlineCount, StringFormat='在线 {0} 人'}" Foreground="#7F8C8D" FontSize="10"/>
                    <TextBlock Text="  ·  " Foreground="#BDC3C7" FontSize="10"/>
                    <TextBlock Text="{Binding AvailabilityText}" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2ECC71"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Available}" Value="False">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶部：运行模式 + 认证 ================= -->
        <Border Grid.Row="0" Background="#34495E">
            <DockPanel LastChildFill="False" Margin="12,0">
                <TextBlock Text="运行模式：" Foreground="White" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbClient" Content="客户端" Foreground="White" VerticalAlignment="Center"
                             GroupName="mode" Margin="12,0,0,0" Checked="RbClient_Checked" IsChecked="True"/>
                <RadioButton x:Name="RbServer" Content="服务器" Foreground="White" VerticalAlignment="Center"
                             GroupName="mode" Margin="16,0,0,0" Checked="RbServer_Checked"/>
                <RadioButton x:Name="RbBoth" Content="客户端 + 服务器" Foreground="White" VerticalAlignment="Center"
                             GroupName="mode" Margin="16,0,0,0" Checked="RbBoth_Checked"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAuthStatus" Foreground="#F1C40F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="注 册" Click="BtnRegister_Click" Background="#3498DB" Foreground="White"
                            BorderThickness="0" Padding="12,4" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 内容区 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 服务器面板 ========== -->
            <Border Grid.Column="0" Background="#F0F2F5" BorderBrush="#BDC3C7" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsServerVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="110"/>
                    </Grid.RowDefinitions>

                    <!-- 服务器状态栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Server.StatusText}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="端口：" VerticalAlignment="Center" Margin="20,0,4,0"/>
                        <TextBox x:Name="TxtServerPort" Text="{Binding Server.PortText}" Width="70" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnStartServer" Content="创建服务器" Click="BtnStartServer_Click"
                                Background="#3498DB" Foreground="White" BorderThickness="0" Padding="14,5"
                                Margin="10,0,0,0" Cursor="Hand"/>
                        <Button x:Name="BtnStopServer" Content="关闭服务器" Click="BtnStopServer_Click"
                                Background="#E74C3C" Foreground="White" BorderThickness="0" Padding="14,5"
                                Margin="8,0,0,0" Cursor="Hand"/>
                    </StackPanel>

                    <!-- 房间管理栏 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="房间号：" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtNewRoomId" Text="{Binding Server.CreateRoomId}" Width="70" VerticalContentAlignment="Center"
                                 ToolTip="留空则随机生成 4~6 位"/>
                        <TextBlock Text="名称：" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtNewRoomName" Text="{Binding Server.CreateRoomName}" Width="140" VerticalContentAlignment="Center"/>
                        <Button Content="创建房间" Click="BtnCreateRoom_Click" Background="#2ECC71" Foreground="White"
                                BorderThickness="0" Padding="14,5" Margin="10,0,0,0" Cursor="Hand"/>
                        <Button Content="关闭选中房间" Click="BtnCloseRoom_Click" Background="#E74C3C" Foreground="White"
                                BorderThickness="0" Padding="14,5" Margin="8,0,0,0" Cursor="Hand"/>
                    </StackPanel>

                    <!-- 房间列表 -->
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="DgvRooms" ItemsSource="{Binding Server.Rooms}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column"
                                  Background="White" BorderBrush="#D5DBDB" BorderThickness="1"
                                  RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="房间号" Binding="{Binding RoomId}" Width="70"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="在线" Binding="{Binding OnlineCount}" Width="55"/>
                                <DataGridTextColumn Header="总人数" Binding="{Binding TotalText}" Width="70"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 服务器统计 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="{Binding Server.ConnectedCountText}" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding Server.OnlineUserText}" Foreground="#7F8C8D" Margin="16,0,0,0"/>
                        <TextBlock Text="{Binding Server.RoomCountText}" Foreground="#7F8C8D" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- 日志 -->
                    <Border Grid.Row="4" Background="White" BorderBrush="#D5DBDB" BorderThickness="1" Margin="0,0,0,0">
                        <ListBox x:Name="LstServerLog" ItemsSource="{Binding Server.Logs}" FontFamily="Consolas" FontSize="11"
                                 Foreground="#34495E" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ========== 客户端面板 ========== -->
            <Border Grid.Column="1" Background="White"
                    Visibility="{Binding IsClientVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 连接栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="IP：" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtServerIp" Text="{Binding Client.ServerIp}" Width="110" VerticalContentAlignment="Center"/>
                        <TextBlock Text="端口：" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="TxtClientPort" Text="{Binding Client.PortText}" Width="55" VerticalContentAlignment="Center"/>
                        <TextBlock Text="用户名：" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="TxtUserName" Text="{Binding Client.UserName}" Width="110" VerticalContentAlignment="Center"/>
                        <Button Content="连接" Click="BtnConnect_Click" Background="#3498DB" Foreground="White"
                                BorderThickness="0" Padding="14,5" Margin="10,0,0,0" Cursor="Hand"/>
                        <Button Content="断开" Click="BtnDisconnect_Click" Background="#95A5A6" Foreground="White"
                                BorderThickness="0" Padding="14,5" Margin="8,0,0,0" Cursor="Hand"/>
                        <TextBlock Text="{Binding Client.StatusText}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="  ID: " VerticalAlignment="Center" Foreground="#95A5A6"/>
                        <TextBlock Text="{Binding Client.UserId}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="#95A5A6"/>
                    </StackPanel>

                    <!-- 房间操作栏 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="加入房间号：" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtJoinRoom" Text="{Binding Client.JoinRoomInput}" Width="90" VerticalContentAlignment="Center"/>
                        <Button Content="加入房间" Click="BtnJoinRoom_Click" Background="#2ECC71" Foreground="White"
                                BorderThickness="0" Padding="12,5" Margin="8,0,0,0" Cursor="Hand"/>
                        <Button Content="退出当前房间" Click="BtnLeaveRoom_Click" Background="#E74C3C" Foreground="White"
                                BorderThickness="0" Padding="12,5" Margin="8,0,0,0" Cursor="Hand"/>
                        <TextBlock Text="{Binding Client.StatusDetail}" VerticalAlignment="Center" Foreground="#7F8C8D"
                                   Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 主体：房间列表 | 聊天区 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 已加入房间列表 -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F7F9FA" BorderBrush="#D5DBDB" BorderThickness="1">
                                <ListView x:Name="LstJoinedRooms" ItemsSource="{Binding Client.JoinedRooms}"
                                          SelectionChanged="LstJoinedRooms_SelectionChanged"
                                          Background="Transparent" BorderThickness="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Border>
                            <TextBlock Grid.Row="1" Text="点击房间切换聊天" Foreground="#BDC3C7" FontSize="10"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- 聊天区 -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="44"/>
                            </Grid.RowDefinitions>

                            <!-- 标题 -->
                            <Border Grid.Row="0" Background="#ECF0F1" CornerRadius="3">
                                <TextBlock Text="{Binding Client.ActiveRoomTitle}" FontWeight="Bold" Foreground="#2C3E50"
                                           VerticalAlignment="Center" Margin="10,0"/>
                            </Border>

                            <!-- 消息区 + 用户列表 -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FCFDFD" BorderBrush="#D5DBDB" BorderThickness="1">
                                    <ListBox x:Name="LstMessages" ItemsSource="{Binding Client.Messages}"
                                             Background="Transparent" BorderThickness="0" Padding="8"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>

                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="房间用户" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Background="#F7F9FA" BorderBrush="#D5DBDB" BorderThickness="1">
                                        <ListBox ItemsSource="{Binding Client.Users}" Background="Transparent" BorderThickness="0" FontSize="11">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,1" CornerRadius="3" Padding="3,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                                        <Setter Property="Background" Value="#D6EAF8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="#2ECC71" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding UserName}" Margin="6,0,0,0" Foreground="#2C3E50">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding UserId}" FontSize="9" Foreground="#95A5A6" Margin="6,0,0,0"/>
                                                            <TextBlock Text="(我)" FontSize="10" FontWeight="Bold" Foreground="#27AE60" Margin="4,0,0,0"
                                                                       Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- 输入栏 -->
                            <Border Grid.Row="2" Background="#F7F9FA" BorderBrush="#D5DBDB" BorderThickness="1" Margin="0,6,0,0" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtMessage" Text="{Binding Client.InputText}"
                                             VerticalContentAlignment="Center" KeyDown="TxtMessage_KeyDown"/>
                                    <Button Grid.Column="1" Content="发送" Click="BtnSend_Click" Background="#3498DB" Foreground="White"
                                            BorderThickness="0" Padding="16,5" Margin="8,0,0,0" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="发送文件" Click="BtnSendFile_Click" Background="#F39C12" Foreground="White"
                                            BorderThickness="0" Padding="12,5" Margin="8,0,0,0" Cursor="Hand"/>
                                    <Button Grid.Column="3" Content="发送图片" Click="BtnSendImage_Click" Background="#8E44AD" Foreground="White"
                                            BorderThickness="0" Padding="12,5" Margin="8,0,0,0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
