<Window x:Class="ChatRoom.Views.ImageViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片查看" Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitle" Foreground="#2C3E50" Margin="0,0,0,6" TextWrapping="Wrap"/>

        <Border Grid.Row="1" Background="#F0F2F5" BorderBrush="#D5DBDB" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Image x:Name="ImgView" Stretch="None" Margin="10"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCopy" Content="复制" Width="72" Height="30" Margin="0,0,10,0"
                    Click="BtnCopy_Click" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnSave" Content="下载" Width="72" Height="30" Margin="0,0,10,0"
                    Click="BtnSave_Click" Background="#2ECC71" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnClose" Content="关闭" Width="72" Height="30"
                    Click="BtnClose_Click" Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
